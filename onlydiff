#!/usr/bin/env bb

(require '[clojure.java.shell :refer [sh]]
         '[clojure.string :as str]
         '[clojure.java.io :as io]
         '[clojure.set :as set])

;; --- 1. Git Helpers ---

(defn head-exists? []
  (zero? (:exit (sh "git" "rev-parse" "--verify" "HEAD"))))

(defn git-diff [cached? options file]
  (let [args (concat ["git" "diff"]
                     (when cached? ["--cached"])
                     options
                     (when (head-exists?) ["HEAD"])
                     (when file ["--" file]))]
    (apply sh args)))

(defn binary-file? [cached? file]
  (let [{:keys [exit out]} (git-diff cached? ["--numstat" "--diff-filter=d"] file)
        columns (str/split (first (str/split-lines out)) #"\t" 3)]
    (and (zero? exit)
         (= "-" (first columns))
         (= "-" (second columns)))))

(defn text-file? [cached? file]
  (let [path (.toPath (io/file file))]
    (and (java.nio.file.Files/isRegularFile path (make-array java.nio.file.LinkOption 0))
         (not (java.nio.file.Files/isSymbolicLink path))
         (not (binary-file? cached? file)))))

(defn get-changed-files [cached? included-files]
  (let [{:keys [exit out err]} (git-diff cached? ["--name-only" "-z" "--diff-filter=d"] nil)]
    (if (zero? exit)
      (let [files (->> (str/split out #"\u0000")
                       (remove str/blank?)
                       (vec))
            selected-files (if (seq included-files)
                             (filterv (set included-files) files)
                             files)
            skipped-files (filterv #(not (text-file? cached? %)) selected-files)]
        (doseq [file skipped-files]
          (println "Skipping non-text file:" file))
        (filterv (complement (set skipped-files)) selected-files))
      (do (println "Error getting git diff:" err) []))))

(defn parse-diff-ranges [diff-out]
  ;; Parses @@ -old,cnt +new,cnt @@
  ;; We care about the +new,cnt part which represents lines in the User State.
  (let [regex #"@@ \-\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@"]
    (->> (re-seq regex diff-out)
         (mapcat (fn [[_ start count]]
                   (let [s (Integer/parseInt start)
                         c (if count (Integer/parseInt count) 1)
                         ;; If count is 0 (deletion), we still track the line 's' as a "touch point"
                         ;; to allow reformatting around the deletion.
                         end (+ s (max 1 c) -1)]
                     (range s (inc end)))))
         (set))))

(defn get-user-touched-lines [cached? file]
  (let [{:keys [exit out]} (git-diff cached? ["-U0"] file)]
    (if (zero? exit)
      (parse-diff-ranges out)
      #{})))

;; --- 2. Patching Logic ---

(defn generate-patch-hunks [original-content new-content]
  (let [f1 (java.io.File/createTempFile "old" ".tmp")
        f2 (java.io.File/createTempFile "new" ".tmp")]
    (spit f1 original-content)
    (spit f2 new-content)
    ;; -U0 is crucial for tight localized patches
    (let [{:keys [out]} (sh "diff" "-U0" (.getAbsolutePath f1) (.getAbsolutePath f2))]
      (.delete f1)
      (.delete f2)
      out)))

(defn parse-and-apply-hunks [original-lines patch-output allowed-lines]
  (let [diff-lines (str/split-lines patch-output)
        header-regex #"^@@ \-(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@.*"]

    ;; 1. Parse Hunks
    (let [hunks (loop [lines diff-lines
                       current-hunk nil
                       acc []]
                  (if (empty? lines)
                    (if current-hunk (conj acc current-hunk) acc)
                    (let [line (first lines)]
                      (if (re-find #"^@@ " line) ;; Start of new hunk
                        (let [matcher (re-find header-regex line)]
                          (if matcher
                            (let [[_ start-str cnt-str _ _] matcher
                                  start (Integer/parseInt start-str)
                                  cnt (if cnt-str (Integer/parseInt cnt-str) 1)
                                  range (if (zero? cnt)
                                          #{start} ;; Check intersection with the insertion point
                                          (set (range start (+ start cnt))))]
                              (if current-hunk
                                (recur (rest lines) {:start start :len cnt :range range :content []} (conj acc current-hunk))
                                (recur (rest lines) {:start start :len cnt :range range :content []} acc)))
                            (recur (rest lines) current-hunk acc)))
                        (if current-hunk
                          (recur (rest lines) (update current-hunk :content conj line) acc)
                          (recur (rest lines) current-hunk acc))))))]

      ;; 2. Filter and Construct Replacements
      (let [replacements (keep (fn [{:keys [start len range content]}]
                                 (if (not-empty (set/intersection range allowed-lines))
                                   (let [added-lines (->> content
                                                          (filter #(str/starts-with? % "+"))
                                                          (map #(subs % 1)))]
                                     {:start start
                                      :len len
                                      :lines added-lines})
                                   nil))
                               hunks)
            ;; Sort reverse to prevent index shifting
            sorted-replacements (sort-by :start > replacements)
            original-vec (vec original-lines)]

        ;; 3. Apply Patch
        (reduce (fn [acc {:keys [start len lines]}]
                  (let [idx (if (zero? len)
                              start       ;; Insertion: Index is `start` (insert after line `start` in 0-based terms roughly)
                              (dec start)) ;; Modification: Index is `start - 1`

                        ;; Safety clamps
                        idx (max 0 (min (count acc) idx))

                        before (subvec acc 0 idx)
                        after (subvec acc (min (count acc) (+ idx len)))]
                    (vec (concat before lines after))))
                original-vec
                sorted-replacements)))))

;; --- 3. Main Workflow ---

(defn reconcile-files [files file-snapshots]
  (doseq [f files]
    (when (contains? file-snapshots f)
      (let [original-content (get-in file-snapshots [f :content])
            original-lines (get-in file-snapshots [f :lines])
            touched-set (get-in file-snapshots [f :touched])
            current-content (slurp f)]

        (if (= original-content current-content)
          (println "No changes by transformer for" f)
          (let [patch-out (generate-patch-hunks original-content current-content)]
            (if (str/blank? patch-out)
              (println "No effective patch for" f)
              (let [final-lines (parse-and-apply-hunks original-lines patch-out touched-set)
                    final-content (str/join "\n" final-lines)]
                (spit f (str final-content "\n"))
                (println "Applied partial formatting to" f)))))))))

(defn cached-files-clean? [cached? files]
  (let [unstaged-files (if cached?
                         (filterv #(not (zero? (:exit (sh "git" "diff" "--quiet" "--" %)))) files)
                         [])]
    (doseq [file unstaged-files]
      (println "Error: cached file also has unstaged changes:" file))
    (empty? unstaged-files)))

(defn parse-cli [raw-args]
  (loop [args raw-args
         cached? false
         append-files? false
         included-files []]
    (cond
      (= "--cached" (first args))
      (recur (rest args) true append-files? included-files)

      (= "--append-files" (first args))
      (recur (rest args) cached? true included-files)

      (= "--file" (first args))
      (if-let [file (second args)]
        (recur (nnext args) cached? append-files? (conj included-files file))
        {:error "--file requires a path"})

      :else
      {:cached? cached?
       :append-files? append-files?
       :included-files included-files
       :transformer-args (vec args)})))

(defn -main [& raw-args]
  (let [{:keys [cached? append-files? included-files transformer-args error]} (parse-cli raw-args)]
    (cond
      error
      (do
        (println "Error:" error)
        1)

      (empty? transformer-args)
      (do
        (println "Usage: onlydiff [--cached] [--append-files] [--file <path>]... <command> [args...]")
        1)

      :else
      (do
        (println "Transformer:" (pr-str transformer-args))
        (let [files (get-changed-files cached? included-files)]
          (cond
            (empty? files)
            (do
              (println "No changed files detected in git.")
              0)

            (not (cached-files-clean? cached? files))
            1

            :else
            (do
              (println "Detected modified files:" files)

              ;; Snapshot
              (let [file-snapshots (reduce (fn [acc f]
                                             (if (.exists (io/file f))
                                               (assoc acc f {:content (slurp f)
                                                             :lines (str/split-lines (slurp f))
                                                             :touched (get-user-touched-lines cached? f)})
                                               acc))
                                           {}
                                           files)]

                ;; Run Transformer
                (println "Running transformer...")
                (let [command-args (if append-files?
                                     (into transformer-args files)
                                     transformer-args)
                      {:keys [exit out err]} (apply sh command-args)]
                  (when-not (str/blank? out)
                    (print out))
                  (if (zero? exit)
                    (println "Transformer finished.")
                    (println "Transformer warning/error:" err))

                  ;; Reconcile
                  (reconcile-files files file-snapshots)
                  exit)))))))))

(System/exit (apply -main *command-line-args*))
